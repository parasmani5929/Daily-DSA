class Solution {
public:
    int smallestNumber(int n, int t) {
        for(int i = n; ; i++){
            int temp = i;
            int product = 1;

            while(temp > 0){
                int d = n % 10;
                if(d == 0){
                    product = 0; 
                    break;
                }
                product *= temp % 10;
                temp = temp/10;
            }
            if(product % t == 0){
                return i;
            }  

        }
        return -1;
    }
};
