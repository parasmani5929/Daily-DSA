class Solution {
public:
    int maxProduct(int n) {
        vector<int> digits;
        int ans = INT_MIN;

        while (n > 0) {
            int d = n % 10;
            digits.push_back(d);
            n /= 10;
        }

        for (int i = 0; i < digits.size(); i++) {
            for (int j = i + 1; j < digits.size(); j++) {
                ans = max(ans, digits[i] * digits[j]);
            }
        }

        return ans;
    }
};
